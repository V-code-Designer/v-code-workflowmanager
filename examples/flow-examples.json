{
  "examples": [
    {
      "name": "Webhook Flow Example",
      "description": "Flow triggered by incoming webhook requests",
      "flow": {
        "steps": [
          {
            "id": "validate",
            "type": "validator",
            "config": {
              "schema": "webhook-payload"
            }
          },
          {
            "id": "process",
            "type": "processor",
            "config": {
              "action": "transform"
            }
          },
          {
            "id": "notify",
            "type": "notification",
            "config": {
              "channel": "slack"
            }
          }
        ]
      },
      "event": {
        "mode": "webhook",
        "command": "/api/webhooks/incoming",
        "option": "async"
      }
    },
    {
      "name": "Scheduled Backup Flow",
      "description": "Automated daily backup flow",
      "flow": {
        "steps": [
          {
            "id": "backup",
            "type": "backup",
            "config": {
              "source": "database",
              "destination": "s3"
            }
          },
          {
            "id": "verify",
            "type": "validator",
            "config": {
              "checksum": true
            }
          },
          {
            "id": "cleanup",
            "type": "maintenance",
            "config": {
              "retention": "30d"
            }
          }
        ]
      },
      "event": {
        "mode": "scheduled",
        "command": "0 2 * * *",
        "option": "cron"
      }
    },
    {
      "name": "Manual Data Migration",
      "description": "Manually triggered data migration flow",
      "flow": {
        "steps": [
          {
            "id": "extract",
            "type": "extractor",
            "config": {
              "source": "legacy-db"
            }
          },
          {
            "id": "transform",
            "type": "transformer",
            "config": {
              "mapping": "v2-schema"
            }
          },
          {
            "id": "load",
            "type": "loader",
            "config": {
              "target": "new-db"
            }
          }
        ]
      },
      "event": {
        "mode": "manual",
        "command": "",
        "option": ""
      }
    },
    {
      "name": "Event-Driven Order Processing",
      "description": "Process orders as they come in",
      "flow": {
        "steps": [
          {
            "id": "validate-order",
            "type": "validator",
            "config": {
              "rules": "order-validation"
            }
          },
          {
            "id": "check-inventory",
            "type": "inventory-check",
            "config": {
              "reserve": true
            }
          },
          {
            "id": "process-payment",
            "type": "payment",
            "config": {
              "gateway": "stripe"
            }
          },
          {
            "id": "create-shipment",
            "type": "shipment",
            "config": {
              "carrier": "fedex"
            }
          }
        ]
      },
      "event": {
        "mode": "webhook",
        "command": "/api/orders/webhook",
        "option": "sync"
      }
    },
    {
      "name": "Hourly Report Generation",
      "description": "Generate reports every hour",
      "flow": {
        "steps": [
          {
            "id": "collect-metrics",
            "type": "metrics-collector",
            "config": {
              "timeframe": "1h"
            }
          },
          {
            "id": "generate-report",
            "type": "report-generator",
            "config": {
              "format": "pdf"
            }
          },
          {
            "id": "email-report",
            "type": "email",
            "config": {
              "recipients": ["team@example.com"]
            }
          }
        ]
      },
      "event": {
        "mode": "scheduled",
        "command": "0 * * * *",
        "option": "cron"
      }
    }
  ]
}
